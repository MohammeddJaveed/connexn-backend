FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY identity/package.json identity/package.json
COPY posts/package.json posts/package.json
COPY api-gateway/package.json api-gateway/package.json
RUN npm ci --include-workspace-root --workspace=@connexn/shared --workspace=posts
COPY packages/shared packages/shared
COPY posts posts
RUN npm run build --workspace=@connexn/shared && npm run build --workspace=posts

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/posts/node_modules ./posts/node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/posts/package.json ./posts/package.json
COPY --from=build --chown=node:node /app/posts/dist ./posts/dist
COPY --from=build --chown=node:node /app/posts/drizzle.config.ts ./posts/drizzle.config.ts
COPY --from=build --chown=node:node /app/posts/src/db ./posts/src/db
COPY --from=build --chown=node:node /app/posts/drizzle ./posts/drizzle
COPY --from=build --chown=node:node /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=node:node /app/packages/shared/dist ./packages/shared/dist

USER node
EXPOSE 3002
CMD ["npm", "run", "start:container", "--workspace=posts"]
