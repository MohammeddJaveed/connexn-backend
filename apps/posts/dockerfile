FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/identity/package.json apps/identity/package.json
COPY apps/posts/package.json apps/posts/package.json
COPY apps/api-gateway/package.json apps/api-gateway/package.json
RUN npm ci --include-workspace-root --workspace=@connexn/shared --workspace=posts
COPY packages/shared packages/shared
COPY apps/posts apps/posts
RUN npm run build --workspace=@connexn/shared && npm run build --workspace=posts

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/posts/node_modules ./apps/posts/node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/apps/posts/package.json ./apps/posts/package.json
COPY --from=build --chown=node:node /app/apps/posts/dist ./apps/posts/dist
COPY --from=build --chown=node:node /app/apps/posts/drizzle.config.ts ./apps/posts/drizzle.config.ts
COPY --from=build --chown=node:node /app/apps/posts/src/db ./apps/posts/src/db
COPY --from=build --chown=node:node /app/apps/posts/drizzle ./apps/posts/drizzle
COPY --from=build --chown=node:node /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=node:node /app/packages/shared/dist ./packages/shared/dist

USER node
EXPOSE 3002
CMD ["npm", "run", "start:container", "--workspace=posts"]
